# Supabase project settings → API. The anon key is safe in the browser; RLS protects the data.
# NEVER put the service_role key in this app or in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin used for canonical URLs, sitemap and Open Graph.
# REQUIRED in production (the production build fails without it). Use the final https:// domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret that signs /og share-image URLs so strangers can't render arbitrary cards.
# Generate one with: openssl rand -base64 32   (leave empty locally)
OG_SIGNING_SECRET=
